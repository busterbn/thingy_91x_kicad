(version 1)
# Nordic's Altium design rules for PCA20065, translated to KiCad.
# Later rules take precedence over earlier ones. Rooms "nRF53" and "nPM6001" are rule areas on the board.

# --- Width ---------------------------------------------------------------------------------------
(rule "Width"
	(condition "A.Type == 'Track'")
	(constraint track_width (min 0.1249mm) (opt 0.125mm) (max 3mm)))

(rule "Width_nRF5340 and nPM6001"
	(condition "A.Type == 'Track' && ((A.Layer == 'B.Cu' && A.intersectsArea('nRF53')) || (A.Layer == 'In4.Cu' && A.intersectsArea('nPM6001')))")
	(constraint track_width (min 0.105mm) (opt 0.254mm) (max 0.254mm)))

(rule "Width_RF"
	(condition "A.Type == 'Track' && A.hasNetclass('RF')")
	(constraint track_width (min 0.035mm) (opt 0.0617mm) (max 0.638mm)))

(rule "Width_RF_BLE/WIFI"
	(condition "A.Type == 'Track' && A.hasNetclass('RF_BLE/WIFI')")
	(constraint track_width (min 0.035mm) (opt 0.0617mm) (max 0.29mm)))

# Altium routes the USB pairs with an impedance profile (0.083 mm necks); KiCad has no equivalent.
(rule "Width_Diff"
	(condition "A.Type == 'Track' && A.inDiffPair('*')")
	(constraint track_width (min 0.083mm) (opt 0.165mm) (max 0.165mm))
	(constraint diff_pair_gap (min 0.127mm) (opt 0.127mm)))

# --- Clearance -----------------------------------------------------------------------------------
(rule "Polygon_Clearance"
	(condition "A.Type == 'Zone' && A.NetName == 'GND'")
	(constraint clearance (min 0.18mm)))

(rule "RF_Clearance_RF_BLE/WIFI"
	(condition "A.hasNetclass('RF_BLE/WIFI') && B.Type == 'Zone' && B.NetName == 'GND' && (B.Layer == 'F.Cu' || B.Layer == 'B.Cu')")
	(constraint clearance (min 0.2mm)))

(rule "USB_Poly_Clearance"
	(condition "A.inDiffPair('*') && B.Type == 'Zone' && B.NetName == 'GND'")
	(constraint clearance (min 0.5mm)))

(rule "Diff_Pair_Clearance_Other_Diffpair"
	(condition "A.inDiffPair('*') && (A.Type == 'Track' || A.Type == 'Arc') && B.inDiffPair('*') && A.NetName != B.NetName && !A.isCoupledDiffPair()")
	(constraint clearance (min 0.3mm)))

(rule "Clearance_nPM6001"
	(condition "A.Layer == 'In4.Cu' && B.intersectsArea('nPM6001')")
	(constraint clearance (min 0.105mm)))

(rule "Clearance_nRF5340"
	(condition "B.intersectsArea('nRF53')")
	(constraint clearance (min 0.1mm)))

(rule "NPTH clearance"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.127mm)))

# --- Vias and holes ------------------------------------------------------------------------------
(rule "RoutingVias_Laser"
	(condition "A.Type == 'Via' && A.Hole < 0.15mm")
	(constraint via_diameter (min 0.25mm) (max 0.325mm))
	(constraint hole_size (min 0.1mm) (max 0.1mm)))

(rule "RoutingVias_Mech"
	(condition "A.Type == 'Via' && A.Hole >= 0.15mm")
	(constraint via_diameter (min 0.5mm) (max 0.5mm))
	(constraint hole_size (min 0.25mm) (max 0.25mm)))

(rule "HoleToHoleClearance_TH"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.Hole >= 0.15mm && B.Hole >= 0.15mm")
	(constraint hole_to_hole (min 0.45mm)))

(rule "HoleToHoleClearance_Micro-Micro"
	(condition "A.Type == 'Via' && B.Type == 'Via' && A.Hole < 0.15mm && B.Hole < 0.15mm && A.Diameter >= 0.3mm && B.Diameter >= 0.3mm")
	(constraint hole_to_hole (min 0.3mm)))

# --- Board edge ----------------------------------------------------------------------------------
(rule "BoardOutlineClearance"
	(constraint edge_clearance (min 0.24mm)))
